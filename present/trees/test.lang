import "binary_tree.lang"

int main() {
    Tree trees = Tree();
    Tree::IntTree t = trees.new_tree();

    t = trees.insert(t, 8);
    t = trees.insert(t, 3);
    t = trees.insert(t, 10);
    t = trees.insert(t, 1);
    t = trees.insert(t, 6);
    t = trees.insert(t, 14);
    t = trees.insert(t, 4);
    t = trees.insert(t, 7);
    t = trees.insert(t, 13);
    t = trees.insert(t, 6);     // Дубликат не добавится

    print("tree size:");
    print(t.size);

    print("in order:");
    trees.print_in_order(t);    // 1 3 4 6 7 8 10 13 14

    print("pre order:");
    trees.print_pre_order(t);   // 8 3 1 6 4 7 10 14 13

    print("post order:");
    trees.print_post_order(t);  // 1 4 7 6 3 13 14 10 8

    print("contains 7?");
    print(trees.contains(t, 7));

    print("contains 99?");
    print(trees.contains(t, 99));

    trees.min_value(t);         // 1
    trees.max_value(t);         // 14

    print("height:");
    print(trees.height(t));     // 4

    t = trees.delete_value(t, 1);
    print("after deleting 1:");
    trees.print_in_order(t);

    t = trees.delete_value(t, 3);
    print("after deleting 3:");
    trees.print_in_order(t);

    t = trees.delete_value(t, 8);
    print("after deleting 8:");
    trees.print_in_order(t);

    t = trees.delete_value(t, 999);
    print("after deleting 999:");
    trees.print_in_order(t);

    print("final size:");
    print(t.size);

    return 0;
}
